meta {
  name: Update User (admin)
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/users/{{createdUserId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Updated By Bruno"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("name was updated", function() {
    expect(res.body.name).to.equal("Updated By Bruno");
  });
}
