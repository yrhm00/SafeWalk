meta {
  name: Update Comment As Non Owner
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/comments/{{createdCommentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testToken}}
}

body:json {
  {
    "content": "Tentative de modification non autorisée."
  }
}

tests {
  test("status is 403 (not the author, not admin)", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
