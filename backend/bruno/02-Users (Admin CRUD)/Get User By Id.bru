meta {
  name: Get User By Id
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/users/{{createdUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns the expected email", function() {
    expect(res.body.email).to.equal("admincreated@mail.com");
  });
}
